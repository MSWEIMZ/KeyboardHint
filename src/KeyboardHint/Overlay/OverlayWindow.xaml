<Window x:Class="KeyboardHint.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="#F6141418"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Visibility="Collapsed">
    <Border x:Name="RootBorder" CornerRadius="8" Opacity="0"
            Padding="18,12,18,16"
            Background="#C0141418"
            BorderBrush="#14FFFFFF"
            BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="Caption"
                       Foreground="#B8FFFFFF"
                       FontSize="11"
                       FontWeight="Medium"
                       Margin="6,0,0,10"/>
            <StackPanel x:Name="KeyboardPanel"/>
        </StackPanel>
    </Border>
</Window>
