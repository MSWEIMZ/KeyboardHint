<Window x:Class="KeyboardHint.Overlay.ShortcutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="键盘小助手 · 快捷键编辑器" Width="600" Height="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        MinWidth="520" MinHeight="440" Topmost="True" WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="8" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- custom title bar -->
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="键" FontSize="11" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="快捷键编辑器" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                <Button x:Name="BtnMin" Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="OnMin"/>
                <Button x:Name="BtnMax" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="OnMax"/>
                <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="应用" Style="{StaticResource Sec}"/>
                    <DockPanel>
                        <Button Content="导入…" Padding="14,5" Margin="8,0,0,0" DockPanel.Dock="Right"
                                Click="OnImport" ToolTip="从 JSON 文件导入一份快捷键配置"/>
                        <Button Content="＋ 新建应用" Padding="14,5" Margin="8,0,0,0" DockPanel.Dock="Right"
                                Click="OnNewApp" ToolTip="为一个还没有配置的应用创建快捷键配置"/>
                        <ComboBox x:Name="AppBox" SelectionChanged="OnAppChanged"/>
                    </DockPanel>
                    <TextBlock x:Name="ProcText" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="修饰层（按住哪些键时显示）" Style="{StaticResource Sec}" Margin="0,12,0,6"/>
                    <ComboBox x:Name="LayerBox" SelectionChanged="OnLayerChanged"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="0,0,0,1" Padding="14,10">
                        <DockPanel>
                            <TextBlock Text="快捷键列表" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Content="＋ 添加一行" Padding="12,4" Click="OnAddRow" DockPanel.Dock="Right"/>
                            <TextBlock Text="选按键，填功能说明，× 删除" FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="12,0"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                        <StackPanel x:Name="RowsPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="HintText" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="取消" Padding="18,7" Margin="0,0,10,0" Click="OnCancel"/>
                    <Button Content="保存" Padding="22,7" Click="OnSave" Style="{StaticResource AccentButton}"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
