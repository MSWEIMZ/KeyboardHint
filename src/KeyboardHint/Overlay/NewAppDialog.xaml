<Window x:Class="KeyboardHint.Overlay.NewAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="新建应用配置" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Topmost="True" WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="8" GlassFrameThickness="0"
                            ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="新建应用配置" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}"
                    HorizontalAlignment="Right" Margin="0,0,8,0" Click="OnCancel"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,16">
            <StackPanel>
                <TextBlock Text="为还没有快捷键配置的应用创建一个。进程名可在任务管理器 → 详细信息里看到（不带 .exe）。"
                           FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                           TextWrapping="Wrap" LineHeight="16"/>

                <TextBlock Text="应用名称" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,5"/>
                <TextBox x:Name="NameBox" Text="我的应用"/>

                <TextBlock Text="进程名（逗号可填多个，不带 .exe）" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="ProcBox"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="取消" Padding="16,7" Margin="0,0,10,0" Click="OnCancel"/>
                    <Button Content="创建" Padding="20,7" Click="OnOk" Style="{StaticResource AccentButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
