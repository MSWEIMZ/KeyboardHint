<Window x:Class="KeyboardHint.Overlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="键盘小助手 · 设置" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True" WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="8" GlassFrameThickness="0"
                            ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,16,4"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Tip" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- custom title bar -->
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="键" FontSize="11" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="键盘小助手 · 设置" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}"
                    HorizontalAlignment="Right" Margin="0,0,8,0" Click="OnClose"/>
        </Grid>

        <!-- body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="640">
            <StackPanel Margin="16,0,16,16">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="常规" Style="{StaticResource Sec}"/>
                        <WrapPanel>
                            <CheckBox x:Name="ChkEnabled" Content="启用快捷键提示" Style="{StaticResource Chk}"/>
                            <CheckBox x:Name="ChkAutostart" Content="开机自动启动" Style="{StaticResource Chk}"/>
                            <CheckBox x:Name="ChkPin" Content="钉住模式（松开保持显示）" Style="{StaticResource Chk}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="触发键" Style="{StaticResource Sec}"/>
                        <WrapPanel>
                            <CheckBox x:Name="ChkCtrl" Content="Ctrl" Style="{StaticResource Chk}"/>
                            <CheckBox x:Name="ChkAlt" Content="Alt" Style="{StaticResource Chk}"/>
                            <CheckBox x:Name="ChkWin" Content="Win" Style="{StaticResource Chk}"/>
                            <CheckBox x:Name="ChkShift" Content="Shift" Style="{StaticResource Chk}"/>
                        </WrapPanel>
                        <TextBlock Text="按住修饰键，屏幕底部弹出当前应用的快捷键键盘。Shift 快捷键较少，默认关闭。"
                                   Style="{StaticResource Tip}" Margin="0,4,0,0"/>

                        <TextBlock Text="弹出延迟" Style="{StaticResource Sec}" Margin="0,14,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="DelayText" DockPanel.Dock="Right" Width="48"
                                       TextAlignment="Right" Style="{StaticResource Lbl}"/>
                            <Slider x:Name="DelaySlider" Minimum="200" Maximum="1200"
                                    TickFrequency="50" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="面板不透明度" Style="{StaticResource Sec}" Margin="0,10,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="48"
                                       TextAlignment="Right" Style="{StaticResource Lbl}"/>
                            <Slider x:Name="OpacitySlider" Minimum="50" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource Sec}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="主题" Style="{StaticResource Lbl}" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ThemeBox" Width="96">
                                <ComboBoxItem Content="深色" Tag="dark"/>
                                <ComboBoxItem Content="浅色" Tag="light"/>
                            </ComboBox>
                            <TextBlock Text="强调色" Style="{StaticResource Lbl}" Margin="18,0,8,0"/>
                            <ComboBox x:Name="AccentBox" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="排除的进程" Style="{StaticResource Sec}"/>
                        <TextBox x:Name="ExcludedBox"/>
                        <TextBlock Text="逗号分隔，不带 .exe；这些应用内不弹出提示。"
                                   Style="{StaticResource Tip}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="BtnDir" Content="快捷键目录" Padding="14,7" Margin="0,0,10,0" Click="OnOpenDir"/>
                    <Button x:Name="BtnSave" Content="保存" Padding="22,7" Click="OnSave"
                            Style="{StaticResource AccentButton}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
