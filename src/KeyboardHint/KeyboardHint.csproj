<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KeyboardHint</RootNamespace>
    <AssemblyName>KeyboardHint</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyTitle>键盘小助手</AssemblyTitle>
    <Description>按住 Ctrl 弹出当前应用的快捷键提示键盘</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 原生库也打进单文件：发布产物 = 一个 exe，双击即用 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <!-- 体积优化：压缩单文件包内程序集 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 体积优化：不内嵌 ICU 数据，改走 Windows NLS。注意不能用
         InvariantGlobalization —— WPF 绑定引擎会解析 en-US 区域性，
         invariant 模式下 XmlLanguage.GetSpecificCulture() 直接抛异常，
         设置窗口里点任何 CheckBox 都会崩。PredefinedCulturesOnly 省同样的体积且安全。 -->
    <PredefinedCulturesOnly>true</PredefinedCulturesOnly>
    <!-- 体积优化：只保留英文卫星程序集 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 内存优化：后台常驻应用用低功耗 GC 模式 -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Update="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="shortcuts\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <!-- 快捷键配置内嵌进 exe：单文件分发时无需附带 shortcuts 目录；
         exe 旁 shortcuts\ 目录存在时仍然优先（开发/便携模式），用户目录覆盖一切 -->
    <EmbeddedResource Include="shortcuts\**\*.json" />
  </ItemGroup>

</Project>
